---
import Base from '../layouts/Base.astro';
import { catalog, capabilities, label, preview, componentCss } from '../lib/catalog';

const data = catalog();
const tags = capabilities();
const showcase = 'vinyl';
const showcaseHtml = preview(showcase);
const showcaseCss = componentCss(showcase);
---

<Base
  title="PhoenixSEO Components — free page components for WordPress"
  description="Build your own page components for WordPress: fields, markup and stylesheet in one folder. A page stores values, never HTML. Free, GPL-2.0-or-later."
  path="/"
>
  <style is:inline set:html={showcaseCss}></style>

  <div class="hero-band">
    <section class="wrap hero">
      <div class="hero__text">
        <p class="eyebrow">Free · GPL-2.0-or-later · no account, no key</p>
        <h1>Write a component once. Every page follows.</h1>
        <p class="lede">
          A component is a folder: the fields, the markup, the stylesheet. A page stores which
          component sits where and what its fields hold — never the HTML. Edit the template and
          every instance follows.
        </p>
        <p class="lede lede--second">
          You build the hero, the FAQ, the pricing table the design asks for. Copy the folder into
          the next project and the fields come along; swap <code>component.css</code> and it wears
          that site's look.
        </p>
        <div class="hero__actions">
          <a class="button" href="/components/">Browse the components</a>
          <a class="button button--quiet" href="#free">What it costs</a>
        </div>
        <dl class="facts">
          <div><dt>Licence</dt><dd>GPL-2.0-or-later</dd></div>
          <div><dt>Account</dt><dd>none</dd></div>
          <div><dt>Build step</dt><dd>none</dd></div>
          <div><dt>Dependency</dt><dd>ACF free or SCF</dd></div>
        </dl>
      </div>

      <figure class="hero__art">
        <svg class="art" viewBox="0 0 480 352" role="img" aria-labelledby="art-title">
          <title id="art-title"
            >One template edit in render.php reaches every page that uses the component.</title
          >
          <defs>
            <path id="wire-stem" pathLength="100" d="M240 104 V126" />
            <path id="wire-bus" pathLength="100" d="M76 126 H404" />
            <path id="wire-a" pathLength="100" d="M76 126 V166" />
            <path id="wire-b" pathLength="100" d="M240 126 V166" />
            <path id="wire-c" pathLength="100" d="M404 126 V166" />
          </defs>

          <g class="art__wires">
            <use href="#wire-stem" />
            <use href="#wire-bus" />
            <use href="#wire-a" />
            <use href="#wire-b" />
            <use href="#wire-c" />
          </g>
          <g class="art__flows">
            <use href="#wire-stem" class="art__flow" />
            <use href="#wire-bus" class="art__flow" />
            <use href="#wire-a" class="art__flow" />
            <use href="#wire-b" class="art__flow" />
            <use href="#wire-c" class="art__flow" />
          </g>

          <g class="art__src">
            <rect class="art__card" x="130" y="0" width="220" height="104" rx="4" />
            <text x="146" y="24">render.php</text>
            <line x1="130" y1="36" x2="350" y2="36" />
            <rect class="art__line" x="146" y="49" width="116" height="6" rx="1" />
            <rect class="art__line art__line--edit" x="146" y="63" width="96" height="6" rx="1" />
            <rect class="art__caret" x="246" y="60" width="2" height="13" />
            <rect class="art__line" x="146" y="77" width="84" height="6" rx="1" />
            <rect class="art__line" x="146" y="91" width="56" height="6" rx="1" />
          </g>

          {
            [18, 182, 346].map((x, i) => (
              <g class="art__page">
                <rect class="art__card" x={x} y="166" width="116" height="150" rx="4" />
                <circle cx={x + 12} cy="181" r="1.7" />
                <circle cx={x + 20} cy="181" r="1.7" />
                <circle cx={x + 28} cy="181" r="1.7" />
                <line x1={x + 1} y1="192" x2={x + 115} y2="192" />
                <rect class="art__bar" x={x + 14} y="206" width="60" height="8" rx="1" />
                <rect class="art__line" x={x + 14} y="224" width="88" height="4" rx="1" />
                <rect class="art__line" x={x + 14} y="234" width="64" height="4" rx="1" />
                <rect class="art__slot" x={x + 14} y="248" width="88" height="48" rx="2" />
                <text x={x + 58} y="334" text-anchor="middle">
                  {['page 12', 'page 41', 'page 77'][i]}
                </text>
              </g>
            ))
          }
        </svg>
        <figcaption class="art__cap">
          One template edit. Every instance of it, on every page.
        </figcaption>
        <p class="art__note">
          Block patterns bake their markup into the post. Here it stays in the folder. And it costs
          nothing: no account, no key, and the one dependency — ACF or SCF — has a free edition
          that is enough.
        </p>
      </figure>
    </section>
  </div>

  <section class="wrap showcase" aria-labelledby="showcase-title">
    <div class="showcase__head">
      <h2 id="showcase-title">What an example looks like</h2>
      <p class="small soft">
        Not a mock-up. This is the component's own output, rendered by the plugin and frozen at
        build time. The track numbers come from the row order, the running time is added up from
        the individual durations — neither is a field.
      </p>
    </div>
    <div class="preview preview--sunk">
      <Fragment set:html={showcaseHtml} />
    </div>
  </section>

  <section class="wrap pair" aria-labelledby="portable-title">
    <h2 id="portable-title">One library, many sites</h2>
    <div class="pair__cols">
      <div>
        <h3>The component travels</h3>
        <p class="small soft">
          A component is three files in one folder: <code>definition.json</code>,
          <code>render.php</code>, <code>component.css</code>. Copy the folder into another site's
          <code>wp-content/sdc-components/</code> and it works there — same fields, same markup,
          nothing to import and nothing to register twice. The pages bring their own values; that
          is all a site has to add.
        </p>
      </div>
      <div>
        <h3>The look stays a per-site decision</h3>
        <p class="small soft">
          Where two projects should not look alike, keep the values and change the stylesheet. The
          lookup is child theme, parent theme, <code>wp-content/sdc-components/</code>, then the
          plugin — first match wins, for the CSS exactly as for the markup. A theme that ships its
          own <code>component.css</code> for <code>faq</code> restyles every FAQ on that site,
          without touching a page's content and without forking the plugin.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap" id="free" aria-labelledby="free-title">
    <h2 id="free-title">What it costs</h2>
    <p class="soft">Nothing. Not a trial, not a free tier, not free until the site gets traffic.</p>
    <dl class="cost">
      <div>
        <dt>Licence</dt>
        <dd>
          GPL-2.0-or-later, for the plugin and for every component here. Any number of sites,
          commercial work included. There is no per-site fee because there is nobody to pay.
        </dd>
      </div>
      <div>
        <dt>Account</dt>
        <dd>
          None. No key, no login, no usage counter. The plugin runs on your server and reads files
          from the file system; there is no service behind it that could send an invoice.
        </dd>
      </div>
      <div>
        <dt>Field plugin</dt>
        <dd>
          Advanced Custom Fields in its free edition, or Secure Custom Fields, which is free on
          wordpress.org. The free edition is enough: ACF's paid tier adds repeaters, flexible
          content and clone, and the builder renders those containers itself for exactly that
          reason. It asks the host only for single-value fields, where the free and the paid
          edition are the same.
        </dd>
      </div>
      <div>
        <dt>Build step</dt>
        <dd>
          None. PHP, JSON and CSS, edited where they lie. No npm install, no compilation, no deploy
          pipeline for a colour change.
        </dd>
      </div>
    </dl>
  </section>

  <section class="wrap" id="install" aria-labelledby="install-title">
    <h2 id="install-title">Install one in a minute</h2>
    <div class="install">
      <ol class="install__steps">
        <li>
          <strong>Download the component's ZIP</strong>
          <p class="small soft">
            Every component page has one. The same components ship inside the plugin, so this is
            only needed for the ones you add later.
          </p>
        </li>
        <li>
          <strong>Unzip it into <code>wp-content/sdc-components/</code></strong>
          <p class="small soft">
            One directory per component. A copy in that folder takes precedence over the plugin's
            version, becomes editable in the admin, and survives plugin updates.
          </p>
        </li>
        <li>
          <strong>Pick it from the block inserter</strong>
          <p class="small soft">
            Every component type is its own block under <em>PhoenixSEO components</em>. Fill in the
            fields in the sidebar, see the real markup in the canvas.
          </p>
        </li>
      </ol>
      <div class="install__note">
        <p class="eyebrow">Requires</p>
        <p class="small">
          WordPress 6.4 or newer, PHP 7.4 or newer, and either Advanced Custom Fields — the free
          edition is enough — or Secure Custom Fields. No build step, no JavaScript in the frontend.
        </p>
        <p class="small">
          <a href="https://github.com/phoenixseo/sdc-page-builder">Plugin source and releases</a>
        </p>
      </div>
    </div>
  </section>

  <section class="wrap" aria-labelledby="tags-title">
    <h2 id="tags-title">Not every component needs a template</h2>
    <p class="soft">
      Some need no code at all and come out of the generic output. Others carry a template because
      a value has to be computed, an element carries meaning, or a rule spans several rows. Those
      are the ones worth reading before you write your own.
    </p>
    <ul class="taglist">
      {
        tags.map((tag) => (
          <li>
            <a class="chip" href={`/components/?tag=${tag.name}`}>
              {label(tag.name)} <span class="chip--count">{tag.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap prose" aria-labelledby="why-title">
    <h2 id="why-title">Why values and not markup</h2>
    <p>
      The difference shows up on the second edit. A page that carries its own HTML has to be found
      and changed every time the design moves, and until someone does, it keeps a stale copy of the
      old design. A page that carries values follows the template the next time it renders.
    </p>
    <p>
      The saving is measurable: thirty components come out as one meta entry of 12,583 bytes
      instead of 1,933 rows, and saving them costs 4 queries instead of 1,807. Those numbers come
      from the plugin's own test suite, not from a slide.
    </p>
    <p>
      <a href="/format/">How the format works, and how to write your own</a>
    </p>
  </section>
</Base>

<style>
  /* The hero leaves the text column and takes the whole viewport: a band
     with a faint dot grid, cut off at the bottom by a single rule. */
  .hero-band {
    position: relative;
    border-block-end: 1px solid var(--rule);
    background:
      radial-gradient(
        48rem 22rem at 84% -12%,
        color-mix(in oklab, var(--accent) 9%, transparent),
        transparent 72%
      ),
      linear-gradient(180deg, var(--paper-sunk), var(--paper) 72%);
  }

  .hero-band::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      color-mix(in oklab, var(--ink) 16%, transparent) 1px,
      transparent 1.2px
    );
    background-size: 24px 24px;
    mask-image: linear-gradient(180deg, rgb(0 0 0 / 0.5), transparent 72%);
    pointer-events: none;
  }

  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    padding-block: clamp(2.5rem, 5vw, 4.25rem) clamp(2.5rem, 4.5vw, 3.75rem);
  }

  .hero__text {
    min-width: 0;
    max-width: 44rem;
  }

  .hero h1 {
    max-width: 22ch;
    margin-block: 0.55rem 1.05rem;
    font-size: clamp(2.05rem, 1.1rem + 3.2vw, 3.15rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .lede--second {
    margin-top: 0.85rem;
    font-size: 1.05rem;
  }

  /* The picture: one template, three pages, one edit reaching all of them.
     Drawn rather than photographed, so it stays crisp and costs one request
     fewer than nothing. */
  .hero__art {
    margin: 0;
    min-width: 0;
  }

  .art {
    display: block;
    width: 100%;
    max-width: 32rem;
    height: auto;
    margin-inline: auto;
  }

  .art text {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.02em;
    fill: var(--ink-faint);
  }

  .art__card {
    fill: var(--paper);
    stroke: var(--rule-strong);
    stroke-width: 1;
  }

  .art__src text {
    font-size: 13px;
    fill: var(--ink-soft);
  }

  .art__src line,
  .art__page line {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .art__line {
    fill: var(--rule-strong);
  }

  .art__line--edit,
  .art__bar {
    fill: var(--accent);
    transform-box: fill-box;
    transform-origin: 0% 50%;
  }

  .art__caret {
    fill: var(--accent);
  }

  .art__slot {
    fill: var(--paper-sunk);
    stroke: var(--rule);
    stroke-width: 1;
  }

  .art__page circle {
    fill: var(--rule-strong);
  }

  .art__wires use {
    fill: none;
    stroke: var(--rule-strong);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }

  .art__flows use {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 10 1000;
    opacity: 0;
  }

  .art__cap {
    margin-top: 0.9rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-align: center;
  }

  /* The third paragraph moved here: it explains what the drawing shows, so it
     sits beside the drawing instead of pushing the buttons down the page. */
  .art__note {
    margin-top: 1.5rem;
    padding-inline-start: 0.9rem;
    border-inline-start: 2px solid var(--rule-strong);
    max-width: 36rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--ink-soft);
  }

  /* One cycle: the caret types an edit, the edit travels down the wires, all
     three pages change together, everything resets. Ten seconds, then again. */
  @media (prefers-reduced-motion: no-preference) {
    .art__caret {
      animation: art-caret 1.05s steps(1, end) infinite;
    }

    .art__line--edit {
      animation: art-edit 10s ease-in-out infinite;
    }

    .art__flows use {
      animation: art-flow 10s ease-in infinite;
    }

    .art__bar {
      animation: art-bar 10s ease-in-out infinite;
    }
  }

  @keyframes art-caret {
    0%,
    50% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0;
    }
  }

  @keyframes art-edit {
    0%,
    14% {
      transform: scaleX(1);
    }
    22%,
    86% {
      transform: scaleX(1.4);
    }
    96%,
    100% {
      transform: scaleX(1);
    }
  }

  @keyframes art-flow {
    0%,
    24% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
    26% {
      opacity: 1;
    }
    52% {
      stroke-dashoffset: -112;
      opacity: 1;
    }
    54%,
    100% {
      stroke-dashoffset: -112;
      opacity: 0;
    }
  }

  @keyframes art-bar {
    0%,
    52% {
      transform: scaleX(1);
    }
    60%,
    88% {
      transform: scaleX(1.42);
    }
    96%,
    100% {
      transform: scaleX(1);
    }
  }

  @media (max-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .art {
      max-width: 27rem;
    }
  }

  /* The drawing shrinks with the column, and so does its type. Bump the
     labels so they stay above 10px on a phone. */
  @media (max-width: 40rem) {
    .art text {
      font-size: 16px;
    }

    .art__cap {
      font-size: 0.625rem;
      letter-spacing: 0.04em;
    }
  }

  /* Four facts under the hero: the answer to "what does this cost" before
     anyone has to scroll for it. */
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    max-width: 46rem;
    margin: 2.25rem 0 0;
  }

  .facts > div {
    background: var(--paper);
    padding: 0.65rem 0.85rem;
    display: grid;
    gap: 0.15rem;
  }

  .facts dt {
    font-family: var(--mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--ink-faint);
  }

  .facts dd {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .pair__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 2.5rem;
    margin-top: 1.25rem;
  }

  .pair__cols h3 {
    margin: 0 0 0.4rem;
    font-size: 1rem;
    max-width: 34ch;
  }

  .pair__cols p {
    margin: 0;
    max-width: 48ch;
    line-height: 1.65;
  }

  @media (max-width: 46rem) {
    .pair__cols {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  .cost {
    display: grid;
    gap: 0;
    max-width: 72ch;
    margin-top: 1.5rem;
    border-top: 1px solid var(--rule-strong);
  }

  .cost > div {
    display: grid;
    grid-template-columns: minmax(6rem, 8.5rem) minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 0.95rem;
    border-block-end: 1px solid var(--rule);
  }

  .cost dt {
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--ink-faint);
    padding-block-start: 0.25rem;
  }

  .cost dd {
    margin: 0;
    max-width: 62ch;
  }

  @media (max-width: 34rem) {
    .cost > div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }

  .showcase {
    margin-top: 1rem;
  }

  .showcase__head {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .showcase__head p {
    max-width: 62ch;
  }

  .install {
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    margin-top: 1.25rem;
  }

  @media (max-width: 46rem) {
    .install {
      grid-template-columns: 1fr;
    }
  }

  .install__steps {
    display: grid;
    gap: 1.15rem;
    padding-inline-start: 1.35rem;
    counter-reset: step;
    list-style: none;
    max-width: none;
  }

  .install__steps li {
    position: relative;
    padding-inline-start: 2.1rem;
  }

  .install__steps li::before {
    counter-increment: step;
    content: counter(step);
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.1rem;
    width: 1.5rem;
    height: 1.5rem;
    display: grid;
    place-items: center;
    font-family: var(--mono);
    font-size: 0.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    color: var(--ink-soft);
  }

  .install__steps strong {
    display: block;
    font-weight: 600;
  }

  .install__steps p {
    margin-top: 0.2rem;
  }

  .install__note {
    background: var(--paper-sunk);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
    align-self: start;
  }

  .install__note p + p {
    margin-top: 0.7rem;
  }

  .taglist {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin-top: 1.25rem;
  }

  section + section {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .prose p {
    max-width: 64ch;
  }
</style>
