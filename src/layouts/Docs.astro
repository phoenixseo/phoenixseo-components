---
/**
 * Layout for the manual.
 *
 * Same page frame as the rest of the site, plus a chapter list on the left.
 * The chapter list is a real navigation landmark, not a table of contents
 * built from headings: the chapters are five files, and five files are
 * cheaper to keep honest than a generated index that drifts.
 *
 * `doc` is the slug the build gate looks for (`data-doc`).
 */
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  doc: string;
  lede?: string;
}

const { title, description, path, doc, lede } = Astro.props;
const current = Astro.url.pathname;

const chapters = [
  { href: '/docs/', num: '01', label: 'Overview', hint: 'What this is, in five minutes' },
  { href: '/docs/install/', num: '02', label: 'Install', hint: 'Plugin, host, first screen' },
  { href: '/docs/use/', num: '03', label: 'Use a component', hint: 'Insert, fill, duplicate' },
  { href: '/docs/build/', num: '04', label: 'Build a component', hint: 'Fields, markup, styles' },
  { href: '/docs/reference/', num: '05', label: 'Reference', hint: 'Types, helpers, CLI' },
];

const isCurrent = (href: string) => (href === '/docs/' ? current === '/docs/' : current.startsWith(href));
---

<Base title={title} description={description} path={path}>
  <div class="wrap">
    <nav class="crumbs small" aria-label="Breadcrumb">
      <a href="/">Start</a>
      <span aria-hidden="true">/</span>
      <a href="/docs/">Docs</a>
      {
        doc !== 'index' && (
          <>
            <span aria-hidden="true">/</span>
            <span class="mono">{chapters.find((chapter) => chapter.href === path)?.label.toLowerCase() ?? doc}</span>
          </>
        )
      }
    </nav>

    <div class="docs">
      <aside class="docs__aside">
        <p class="eyebrow">Manual</p>
        <ol class="chapters">
          {
            chapters.map((chapter) => (
              <li>
                <a href={chapter.href} aria-current={isCurrent(chapter.href) ? 'page' : undefined}>
                  <span class="chapters__num mono">{chapter.num}</span>
                  <span class="chapters__body">
                    <span class="chapters__label">{chapter.label}</span>
                    <span class="chapters__hint">{chapter.hint}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
        <p class="docs__elsewhere small">
          <a href="/components/">Component library</a><br />
          <a href="/format/">The format</a><br />
          <a href="https://github.com/phoenixseo/sdc-page-builder">Plugin source</a>
        </p>
      </aside>

      <article class="doc" data-doc={doc}>
        {lede && <p class="eyebrow">{lede}</p>}
        <slot />
      </article>
    </div>
  </div>

  <script>
    // One listener for every code block on the page. Same fallback as the
    // source tabs on a component page: the Clipboard API where it exists,
    // execCommand through a hidden field where it does not (http on a LAN
    // address, older Safari).
    const writeClipboard = (text: string): Promise<void> => {
      if (navigator.clipboard?.writeText) {
        return navigator.clipboard.writeText(text);
      }

      return new Promise((resolve, reject) => {
        const area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', '');
        area.style.position = 'fixed';
        area.style.insetBlockStart = '-1000px';
        document.body.append(area);
        area.select();

        try {
          document.execCommand('copy') ? resolve() : reject(new Error('copy refused'));
        } catch (error) {
          reject(error);
        } finally {
          area.remove();
        }
      });
    };

    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-code]')) {
      const label = button.querySelector<HTMLElement>('[data-copy-label]');
      const block = button.closest('.codeblock');
      if (!label || !block) continue;

      const idle = label.textContent ?? 'Copy';
      let timer = 0;

      button.addEventListener('click', async () => {
        const code = block.querySelector('pre code')?.textContent ?? '';

        try {
          await writeClipboard(code);
          button.dataset.state = 'done';
          label.textContent = 'Copied';
        } catch {
          button.dataset.state = 'failed';
          label.textContent = 'Copy failed';
        }

        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          delete button.dataset.state;
          label.textContent = idle;
        }, 1800);
      });
    }
  </script>
</Base>

<style>
  .crumbs {
    display: flex;
    gap: 0.45rem;
    align-items: center;
    padding-block-start: 1.5rem;
    color: var(--ink-faint);
  }

  .crumbs a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .docs {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-block: 2rem 4rem;
    align-items: start;
  }

  .docs__aside {
    position: sticky;
    top: 5.25rem;
    border-inline-end: 1px solid var(--rule);
    padding-inline-end: 1.25rem;
    display: grid;
    gap: 1rem;
  }

  .chapters {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.1rem;
    max-width: none;
  }

  .chapters a {
    display: grid;
    grid-template-columns: 1.9rem minmax(0, 1fr);
    gap: 0.25rem;
    padding: 0.4rem 0.5rem 0.45rem;
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink-soft);
  }

  .chapters a:hover {
    background: var(--paper-sunk);
    color: var(--ink);
  }

  .chapters a[aria-current='page'] {
    background: var(--paper-sunk);
    color: var(--ink);
  }

  .chapters a[aria-current='page'] .chapters__num {
    color: var(--accent-ink);
  }

  .chapters__num {
    font-size: 0.72rem;
    color: var(--ink-faint);
    padding-block-start: 0.15rem;
  }

  .chapters__body {
    display: grid;
    gap: 0.05rem;
  }

  .chapters__label {
    font-size: 0.9375rem;
    font-weight: 550;
    line-height: 1.25;
  }

  .chapters__hint {
    font-size: 0.78rem;
    color: var(--ink-faint);
    line-height: 1.3;
  }

  .docs__elsewhere {
    border-block-start: 1px solid var(--rule);
    padding-block-start: 0.9rem;
    line-height: 1.7;
  }

  .docs__elsewhere a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .docs__elsewhere a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  /* The article itself: a measure, generous steps between sections, headings
     that outrank their paragraphs without shouting. */
  .doc {
    max-width: 46rem;
  }

  .doc :global(> .eyebrow:first-child) {
    margin-block-end: 0.4rem;
  }

  .doc :global(h1) {
    font-size: clamp(1.85rem, 1.2rem + 2.2vw, 2.6rem);
    margin-block-end: 0.75rem;
  }

  .doc :global(h2) {
    font-size: 1.3rem;
    margin-block: 2.6rem 0.7rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--rule);
  }

  .doc :global(h2:first-of-type) {
    margin-block-start: 1.75rem;
  }

  .doc :global(h3) {
    font-size: 1.03rem;
    margin-block: 1.7rem 0.4rem;
    letter-spacing: -0.005em;
  }

  .doc :global(p) {
    max-width: 62ch;
  }

  .doc :global(ul),
  .doc :global(ol) {
    max-width: 62ch;
    padding-inline-start: 1.2rem;
  }

  .doc :global(li + li) {
    margin-block-start: 0.3rem;
  }

  .doc :global(li) {
    line-height: 1.55;
  }

  .doc :global(.steps) {
    list-style: none;
    padding: 0;
    counter-reset: step;
  }

  .doc :global(.steps > li) {
    counter-increment: step;
    display: grid;
    grid-template-columns: 1.85rem minmax(0, 1fr);
    gap: 0.6rem;
    padding-block: 0.75rem;
    border-block-end: 1px solid var(--rule);
  }

  .doc :global(.steps > li:first-child) {
    border-block-start: 1px solid var(--rule);
  }

  .doc :global(.steps > li::before) {
    content: counter(step);
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--ink-faint);
    padding-block-start: 0.22rem;
  }

  .doc :global(.steps > li > * + *) {
    margin-block-start: 0.45rem;
  }

  .doc :global(figure.shot) {
    margin-block: 1.5rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper-sunk);
  }

  .doc :global(figure.shot img) {
    display: block;
    width: 100%;
    height: auto;
    border-block-end: 1px solid var(--rule);
  }

  .doc :global(figure.shot figcaption) {
    padding: 0.55rem 0.85rem;
    font-size: 0.82rem;
    color: var(--ink-soft);
    line-height: 1.45;
  }

  .doc :global(.note) {
    border-inline-start: 2px solid var(--accent);
    background: var(--paper-sunk);
    padding: 0.8rem 1rem;
    margin-block: 1.25rem;
    font-size: 0.9375rem;
    max-width: 62ch;
  }

  .doc :global(.note strong) {
    display: block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    margin-block-end: 0.25rem;
  }

  /* Tables scroll inside themselves on a narrow screen instead of pushing the
     page sideways. The rows stay rows; only the box around them scrolls. */
  .doc :global(table) {
    display: block;
    overflow-x: auto;
    max-width: 100%;
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    margin-block: 1rem;
  }

  .doc :global(th),
  .doc :global(td) {
    text-align: start;
    padding: 0.45rem 0.8rem 0.45rem 0;
    border-block-end: 1px solid var(--rule);
    vertical-align: top;
  }

  .doc :global(th) {
    font-family: var(--mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .doc :global(td code) {
    background: none;
    border: 0;
    padding: 0;
    white-space: nowrap;
  }

  .doc :global(a) {
    text-underline-offset: 0.18em;
  }

  @media (max-width: 60rem) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
    }

    .docs__aside {
      position: static;
      border-inline-end: 0;
      border-block-end: 1px solid var(--rule);
      padding-inline-end: 0;
      padding-block-end: 1.25rem;
    }

    .chapters {
      grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    }

    .docs__elsewhere {
      border-block-start: 0;
      padding-block-start: 0;
    }
  }
</style>
