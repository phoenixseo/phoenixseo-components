---
/**
 * A code block with a copy button.
 *
 * The button is markup, not a script invention: a reader without JavaScript
 * still sees which block is being copied, and the label does not appear out of
 * nowhere. Behaviour lives in the docs layout, one listener for the page.
 */
interface Props {
  code: string;
  label?: string;
  lang?: string;
}

const { code, label, lang } = Astro.props;
const escaped = code.replace(/[&<>]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[char]!);
---

<div class="codeblock">
  <div class="codeblock__bar">
    <span class="mono codeblock__label">{label ?? lang ?? 'code'}</span>
    <button class="copy copy--inline" type="button" data-copy-code>
      <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
        <path
          d="M5.5 5.5V3.75A1.25 1.25 0 0 1 6.75 2.5h5.5a1.25 1.25 0 0 1 1.25 1.25v5.5a1.25 1.25 0 0 1-1.25 1.25H10.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.3"
          stroke-linecap="round"
        />
        <rect x="2.75" y="5.75" width="7.5" height="7.5" rx="1.25" fill="none" stroke="currentColor" stroke-width="1.3" />
      </svg>
      <span data-copy-label>Copy</span>
    </button>
  </div>
  <pre><code set:html={escaped} /></pre>
</div>

<style>
  .codeblock {
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--paper);
    overflow: hidden;
    margin-block: 1.25rem;
  }

  .codeblock__bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.4rem 0.55rem 0.4rem 0.9rem;
    border-block-end: 1px solid var(--rule);
    background: var(--paper-sunk);
  }

  .codeblock__label {
    font-size: 0.75rem;
    color: var(--ink-faint);
    letter-spacing: 0.02em;
  }

  .codeblock pre {
    margin: 0;
    border: 0;
    border-radius: 0;
    background: var(--paper);
  }

  .copy--inline {
    margin-inline-start: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink-soft);
    cursor: pointer;
  }

  .copy--inline:hover {
    color: var(--ink);
    border-color: var(--ink-faint);
  }

  .copy--inline[data-state='done'] {
    color: var(--accent-ink);
    border-color: var(--accent);
  }

  .copy--inline[data-state='failed'] {
    color: var(--warn);
    border-color: var(--warn);
  }
</style>
